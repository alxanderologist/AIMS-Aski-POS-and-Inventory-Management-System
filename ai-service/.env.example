# Optional. If set, the forecast endpoints require this value in the X-AI-Key header;
# use the same AI_SERVICE_KEY in backend/.env. Leave unset to keep the service open (local development).
# AI_SERVICE_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Set to "production" on the real server (same value/meaning as backend/.env's NODE_ENV). When set,
# this service refuses to start unless AI_SERVICE_KEY above is also set. Leave unset for local dev.
NODE_ENV=

# Recommended production start command (not the dev default documented elsewhere):
#   uvicorn main:app --host 127.0.0.1 --port 8000
# Binding to 127.0.0.1 means only this machine can reach it — correct here since the backend and
# this service run on the same store server PC and talk over localhost. Do not bind 0.0.0.0 in
# production; pair with a Windows Firewall rule as an extra layer (see deployment.md Phase 2).
