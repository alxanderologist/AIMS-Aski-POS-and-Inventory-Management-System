DATABASE_URL="postgresql://postgres:admin123@localhost:5432/aims-pos-ims-db?schema=public"

# Used only by `npx prisma migrate dev` / `migrate diff` (not by the running app) to compute schema
# changes safely. Point it at an otherwise-empty database — Prisma creates/drops objects in it
# freely. Not needed for `migrate deploy` (the command an install/update actually runs).
SHADOW_DATABASE_URL="postgresql://postgres:admin123@localhost:5432/aims-pos-ims-db-shadow?schema=public"

# Set to "production" on the real server. Blocks `npm run seed` and every scripts/one-off/* script
# from running (they assume a dev/demo database and would corrupt or wipe real data) — see
# scripts/lib/productionGuard.js. Also makes the startup check below require AI_SERVICE_KEY to be
# set. Set the same value in ai-service/.env — that service enforces the same rule. Leave unset for
# local development.
NODE_ENV=

# Structured logging (services/logger.js, pino). Pretty-printed to the console outside production;
# plain JSON lines to stdout when NODE_ENV=production, for the process manager to redirect/rotate
# into a file (see deployment.md Phase 4). One of: fatal, error, warn, info (default), debug, trace.
LOG_LEVEL=info

# Secret used to sign login JWTs (POST /api/auth/login). Use a long random
# string in every environment; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Extra origin(s) allowed to open the Socket.IO connection (real-time stock/finance updates),
# comma-separated. http://localhost:5173 is always allowed and does not need to be listed here.
# Set this when the frontend is reached from somewhere else, e.g. a VS Code port-forwarded or
# tunneled URL when testing from another device. Leave blank for normal local dev.
FRONTEND_URL=

# --- SMTP (Gmail) for low-stock and expiry email alerts ---
# 1. Go to https://myaccount.google.com/security  →  turn ON 2-Step Verification.
# 2. Then https://myaccount.google.com/apppasswords  →  create an App Password
#    named "AIMS POS" and paste the 16 characters (no spaces) into SMTP_PASS
#    below. Regular Gmail passwords are rejected.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Comma-separated list of recipients. Leave empty to disable alert emails.
ALERT_RECIPIENTS=

# Optional overrides
EXPIRY_WARN_DAYS=30

# Daily digest schedule (node-cron syntax). Default: 08:00 every day.
DAILY_DIGEST_CRON=0 8 * * *
TZ=Asia/Manila

# --- Nightly database backup (services/backup.js) ---
# Runs pg_dump (custom format, restorable with pg_restore) on the schedule below, keeps a rolling
# local window of dumps, and mirrors each one to the external drive / cloud folder paths when set.
# Test a restore periodically with: node scripts/restoreBackupTest.js
# BACKUP_CRON=30 1 * * *            (node-cron syntax; default 01:30 store time, after the digest)
# BACKUP_DIR=                        (local staging folder; defaults to backend/backups)
# BACKUP_EXTERNAL_DIR=                (e.g. an external/USB drive path; skipped with a warning if unset)
# BACKUP_CLOUD_DIR=                   (a synced cloud folder, e.g. Google Drive/Dropbox/OneDrive; same)
# BACKUP_RETENTION_DAYS=14
# pg_dump/pg_restore/psql aren't on PATH by default on a Windows Postgres install — set this to the
# Postgres "bin" folder if so (e.g. C:\Program Files\PostgreSQL\18\bin). Leave unset if they're on PATH.
# PG_BIN_DIR=

# --- AI forecast ---
# Where the FastAPI forecast service listens, and how long to wait before using the built-in fallback.
# STORE_TIMEZONE sets which calendar day a sale belongs to (defaults to TZ, then Asia/Manila).
# PYTHON_AI_URL=http://localhost:8000/api/v1/forecast
# PYTHON_AI_TIMEOUT_MS=5000   (one retry, then the built-in engine; after 3 failures in a row the service is skipped for 60s)
# FORECAST_CACHE_SECONDS=300   (forecast is recomputed after any sale/stock/order change; 0 turns the cache off)
# Optional shared secret. If set, put the same value in ai-service/.env; the AI service then rejects calls without it.
# AI_SERVICE_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# FORECAST_HISTORY_DAYS=180
# Nightly save of the day's forecast for accuracy grading (node-cron syntax, store time zone).
# FORECAST_SNAPSHOT_CRON=5 0 * * *
# PYTHON_AI_BACKTEST_URL=http://localhost:8000/api/v1/backtest
# STORE_TIMEZONE=Asia/Manila

# --- Receipt printer (silent, no browser dialog) ---
# The backend sends raw ESC/POS commands straight to the receipt printer, so checkout never opens
# a print dialog. Leave unset to disable printing (checkout still succeeds; the print is just
# skipped and logged). Two forms, depending on how the printer is connected:
#   RECEIPT_PRINTER_INTERFACE=tcp://192.168.1.50:9100        # network printer (port 9100 = "JetDirect")
#   RECEIPT_PRINTER_INTERFACE=printer:EPSON_TMT82X            # USB printer, via a Windows print share
# The printer: form needs the printer shared in Windows first (Properties > Sharing > Share this
# printer, share name with no spaces) — see print.md for the full USB setup walkthrough.
# RECEIPT_PRINTER_TYPE selects the ESC/POS command set: epson (default,
# works with most generic/clone thermal printers), star, tanca, daruma, or
# brother — check your printer's manual if receipts print garbled.
RECEIPT_PRINTER_INTERFACE=
RECEIPT_PRINTER_TYPE=epson

# --- Store identity (printed on receipts and the Z-Reading report) ---
# STORE_SN is the POS terminal's serial/accreditation number a BIR-style printout expects —
# there is no safe default, set the real one before Z-Readings are used for anything official.
STORE_NAME=ASKI MULTI-PURPOSE COOPERATIVE
STORE_TIN=295-473-553-000 NON VAT
STORE_SN=REPLACE-WITH-SN
STORE_ADDRESS_LINE1=#135 Barangay Andal Aliano
STORE_ADDRESS_LINE2=Talavera, Nueva Ecija
STORE_TERMINAL_NO=001

# --- POS accreditation block (printed on the receipt footer) ---
# Identifies whoever supplied the BIR-accredited POS software/terminal (not AIMS, not the store
# itself). No safe defaults — these carry real compliance weight, so they MUST be replaced with
# the store's actual accreditation before receipts are used as official BIR documents.
POS_PROVIDER_NAME=REPLACE-WITH-POS-PROVIDER
POS_PROVIDER_ADDRESS=REPLACE-WITH-POS-PROVIDER-ADDRESS
POS_PROVIDER_VAT_TIN=REPLACE-WITH-PROVIDER-TIN
POS_PROVIDER_ACCR=REPLACE-WITH-ACCR-NO
POS_PTU_DATE=REPLACE-WITH-PTU-DATE
POS_PTU_VALID_UNTIL=REPLACE-WITH-PTU-VALID-UNTIL
POS_PTUM=REPLACE-WITH-PTUM
